{
  "expo": {
    "name": "Tawveeri",
    "slug": "tawveeri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tawveeri",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D47A1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tawveeri.app",
      "associatedDomains": [
        "applinks:tawveeri.com",
        "applinks:www.tawveeri.com"
      ],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["ar", "en"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D47A1"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tawveeri.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tawveeri.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "tawveeri.com",
              "pathPrefix": "/auth"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tawveeri to access your photos to set a profile picture.",
          "cameraPermission": "Allow Tawveeri to use your camera to take a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0D47A1"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tawveeri to use your camera to scan barcodes and search for products."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
