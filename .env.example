# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database URL for running scripts
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_DB_URL=your_database_connection_url

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tawveeri

# AI Recommendations (Google Gemini - for product embedding generation via Edge Function)
# Set this as a Supabase secret: supabase secrets set GOOGLE_AI_API_KEY=AIza...
# GOOGLE_AI_API_KEY=your_google_ai_api_key

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=noreply@styloforge.com

# Email (SendGrid) — API key from SendGrid dashboard
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@tawveeri.com
SENDGRID_FROM_NAME=Tawveeri

