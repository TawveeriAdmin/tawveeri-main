    "tps:ingest-provider": "tsx scripts/tps-core/ingest-via-provider.ts",
    "tps:feed-probe": "tsx scripts/tps-analysis/feed-overlap-probe.ts",
    "tps:gate-audit": "tsx scripts/tps-analysis/e15-5-gate-audit.ts",
    "tps:usage": "tsx scripts/tps-analysis/usage-report.ts",
    "tps:gtin-coverage": "tsx scripts/tps-analysis/gtin-coverage.ts",
