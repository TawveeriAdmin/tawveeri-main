    "tps:plugin-yield": "tsx scripts/tps-analysis/plugin-yield.ts",
    "tps:plugin-failures": "tsx scripts/tps-analysis/plugin-failures.ts",
    "tps:health": "tsx scripts/tps-analysis/platform-health.ts",
