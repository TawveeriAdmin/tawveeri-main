    "flask:start": "./scripts/scraping/run-flask.sh",
    "flask:dev": "FLASK_DEBUG=true ./scripts/scraping/run-flask.sh",
    "flask:check": "./scripts/scraping/check-flask.sh",
    "test:integration": "jest tests/auth/audit.test.ts tests/auth/notifications.test.ts tests/auth/profile.test.ts tests/auth/phone-otp.test.ts --testPathIgnorePatterns /node_modules/ /.next/ /mobile/",
    "typecheck": "tsc --noEmit",
