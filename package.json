    "tps:launch-audit": "tsx scripts/tps-analysis/launch-audit.ts",
    "tps:security-audit": "tsx scripts/tps-analysis/security-audit.ts",
    "tps:ui-journey": "node scripts/tps-analysis/ui-journey.js",
    "tps:dead-links": "node scripts/tps-analysis/dead-links.js",
    "tps:shell-verify": "node scripts/tps-analysis/shell-verify.js",
    "tps:vocabulary-scan": "tsx scripts/tps-analysis/vocabulary-scan.ts",
    "tps:validator-verify": "tsx scripts/tps-analysis/validator-verify.ts",
    "tps:validation-log-health": "tsx scripts/tps-analysis/validation-log-health.ts",
    "tps:noon-sitemap": "tsx scripts/tps-analysis/noon-sitemap-probe.ts",
    "tps:sitemap-verify": "tsx scripts/tps-analysis/sitemap-verify.ts",
    "tps:social-readiness": "tsx scripts/tps-analysis/social-readiness.ts"
