    "cronLines": [
      "# GREEN, because liveness (\"the process answers\") is not health (\"the product can answer\").",
      "# `/api/health/deep` was built as the answer to that, but nothing was calling it on a",
      "# could not find any continuous caller, and `railway.toml` had no healthcheckPath at all.",
      "# (tps-heartbeat.yml) with the same secret store. A failing job emails the repo owner",
      "# `/api/health/deep` fails OPEN on `degraded` (200 + healthy:true) because a consumer",
      "# being non-empty fails this job even though the endpoint calls itself healthy.",
      "- cron: '*/15 * * * *'",
      "group: health-watch",
      "deep-health:",
      "# outage, and a deep-health failure below would only be a symptom of it.",
      "code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 30 https://tawveeri.com/ar)",
      "- name: Deep health — data path, not just liveness",
      "body=$(curl -s --max-time 45 https://tawveeri.com/api/health/deep)",
      "echo \"::error title=Deep health unreachable::empty response from /api/health/deep\"",
      "healthy=$(echo \"$body\"   | jq -r '.healthy // false')",
      "echo \"healthy=$healthy age_hours=$age db_latency_ms=$latency\"",
      "if [ \"$healthy\" != \"true\" ]; then",
      "# /api/health/deep only calls data stale at 48h (STALE_HOURS) because it must fail"
    ]
  },
