/* ============================================
   Tawveeri Global Styles - Tailwind CSS v4
   Professional Price Comparison Theme
   ============================================ */

@import "tailwindcss";

/* ============================================
   CUSTOM THEME - Light Mode First
   ============================================ */

@theme {
  /* ============================================
     CRITICAL: ALL colors used in the app MUST be defined here
     to prevent Tailwind v4 from generating OKLCH colors
     ============================================ */

  /* Base Colors - REQUIRED for light/dark mode */
  --color-white: #ffffff;
  --color-black: #000000;

  /* Gray Scale - REQUIRED for all UI elements */
  --color-gray-50: #f9fafb;
  --color-gray-100: #f3f4f6;
  --color-gray-200: #e5e7eb;
  --color-gray-300: #d1d5db;
  --color-gray-400: #9ca3af;
  --color-gray-500: #6b7280;
  --color-gray-600: #4b5563;
  --color-gray-700: #374151;
  --color-gray-800: #1f2937;
  --color-gray-900: #111827;
  --color-gray-950: #030712;

  /* Blue Scale - Used in gradients */
  --color-blue-50: #eff6ff;
  --color-blue-100: #dbeafe;
  --color-blue-200: #bfdbfe;
  --color-blue-300: #93c5fd;
  --color-blue-400: #60a5fa;
  --color-blue-500: #3b82f6;
  --color-blue-600: #2563eb;
  --color-blue-700: #1d4ed8;
  --color-blue-800: #1e40af;
  --color-blue-900: #1e3a8a;
  --color-blue-950: #172554;

  /* Green Scale - Used in gradients */
  --color-green-50: #f0fdf4;
  --color-green-100: #dcfce7;
  --color-green-200: #bbf7d0;
  --color-green-300: #86efac;
  --color-green-400: #4ade80;
  --color-green-500: #22c55e;
  --color-green-600: #16a34a;
  --color-green-700: #15803d;
  --color-green-800: #166534;
  --color-green-900: #14532d;
  --color-green-950: #052e16;

  /* Amber Scale - Used in gradients */
  --color-amber-50: #fffbeb;
  --color-amber-100: #fef3c7;
  --color-amber-200: #fde68a;
  --color-amber-300: #fcd34d;
  --color-amber-400: #fbbf24;
  --color-amber-500: #f59e0b;
  --color-amber-600: #d97706;
  --color-amber-700: #b45309;
  --color-amber-800: #92400e;
  --color-amber-900: #78350f;
  --color-amber-950: #451a03;

  /* Primary - Trust Blue (Brand Color) */
  --color-primary-50: #eff6ff;
  --color-primary-100: #dbeafe;
  --color-primary-200: #bfdbfe;
  --color-primary-300: #93c5fd;
  --color-primary-400: #60a5fa;
  --color-primary-500: #3b82f6;
  --color-primary-600: #2563eb;
  --color-primary-700: #1d4ed8;
  --color-primary-800: #1e40af;
  --color-primary-900: #1e3a8a;
  --color-primary-950: #172554;

  /* Success - Emerald Green (Best Price) */
  --color-success-50: #ecfdf5;
  --color-success-100: #d1fae5;
  --color-success-200: #a7f3d0;
  --color-success-300: #6ee7b7;
  --color-success-400: #34d399;
  --color-success-500: #10b981;
  --color-success-600: #059669;
  --color-success-700: #047857;
  --color-success-800: #065f46;
  --color-success-900: #064e3b;
  --color-success-950: #022c22;

  /* Warning - Red (Hot Deals, Urgency) */
  --color-warning-50: #fef2f2;
  --color-warning-100: #fee2e2;
  --color-warning-200: #fecaca;
  --color-warning-300: #fca5a5;
  --color-warning-400: #f87171;
  --color-warning-500: #ef4444;
  --color-warning-600: #dc2626;
  --color-warning-700: #b91c1c;
  --color-warning-800: #991b1b;
  --color-warning-900: #7f1d1d;
  --color-warning-950: #450a0a;

  /* Featured - Amber (Premium Stores) */
  --color-featured-50: #fffbeb;
  --color-featured-100: #fef3c7;
  --color-featured-200: #fde68a;
  --color-featured-300: #fcd34d;
  --color-featured-400: #fbbf24;
  --color-featured-500: #f59e0b;
  --color-featured-600: #d97706;
  --color-featured-700: #b45309;
  --color-featured-800: #92400e;
  --color-featured-900: #78350f;
  --color-featured-950: #451a03;

  /* Font Families */
  --font-sans: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-sans-ar: "IBM Plex Sans Arabic", "Noto Sans Arabic", system-ui, sans-serif;
}

/* ============================================
   FORCE LIGHT THEME COLORS WITH UTILITY CLASSES
   Tailwind v4 is using OKLCH - override everything
   ============================================ */

@layer utilities {
  /* ===============================================
     LIGHT MODE UTILITIES (default) - Complete Set
     =============================================== */

  /* ===== BACKGROUND COLORS ===== */
  html:not(.dark) .bg-white {
    background-color: #ffffff !important;
  }

  html:not(.dark) .bg-gray-50 {
    background-color: #f9fafb !important;
  }

  html:not(.dark) .bg-gray-100 {
    background-color: #f3f4f6 !important;
  }

  html:not(.dark) .bg-gray-200 {
    background-color: #e5e7eb !important;
  }

  html:not(.dark) .bg-gray-300 {
    background-color: #d1d5db !important;
  }

  /* Primary colors */
  html:not(.dark) .bg-primary-50 {
    background-color: #eff6ff !important;
  }

  html:not(.dark) .bg-primary-100 {
    background-color: #dbeafe !important;
  }

  html:not(.dark) .bg-primary-600 {
    background-color: #2563eb !important;
  }

  html:not(.dark) .bg-primary-800 {
    background-color: #1e40af !important;
  }

  html:not(.dark) .bg-primary-900 {
    background-color: #1e3a8a !important;
  }

  /* Success colors */
  html:not(.dark) .bg-success-50 {
    background-color: #ecfdf5 !important;
  }

  html:not(.dark) .bg-success-100 {
    background-color: #d1fae5 !important;
  }

  html:not(.dark) .bg-success-600 {
    background-color: #059669 !important;
  }

  html:not(.dark) .bg-success-700 {
    background-color: #047857 !important;
  }

  html:not(.dark) .bg-success-900 {
    background-color: #064e3b !important;
  }

  /* Warning colors */
  html:not(.dark) .bg-warning-50 {
    background-color: #fef2f2 !important;
  }

  html:not(.dark) .bg-warning-100 {
    background-color: #fee2e2 !important;
  }

  html:not(.dark) .bg-warning-600 {
    background-color: #dc2626 !important;
  }

  html:not(.dark) .bg-warning-700 {
    background-color: #b91c1c !important;
  }

  html:not(.dark) .bg-warning-900 {
    background-color: #7f1d1d !important;
  }

  /* Featured colors */
  html:not(.dark) .bg-featured-100 {
    background-color: #fef3c7 !important;
  }

  html:not(.dark) .bg-featured-800 {
    background-color: #92400e !important;
  }

  /* ===== TEXT COLORS ===== */
  html:not(.dark) .text-white {
    color: #ffffff !important;
  }

  html:not(.dark) .text-gray-400 {
    color: #9ca3af !important;
  }

  html:not(.dark) .text-gray-500 {
    color: #6b7280 !important;
  }

  html:not(.dark) .text-gray-600 {
    color: #4b5563 !important;
  }

  html:not(.dark) .text-gray-700 {
    color: #374151 !important;
  }

  html:not(.dark) .text-gray-900 {
    color: #111827 !important;
  }

  /* Primary text */
  html:not(.dark) .text-primary-600 {
    color: #2563eb !important;
  }

  html:not(.dark) .text-primary-800 {
    color: #1e40af !important;
  }

  html:not(.dark) .text-primary-900 {
    color: #1e3a8a !important;
  }

  /* Success text */
  html:not(.dark) .text-success-600 {
    color: #059669 !important;
  }

  html:not(.dark) .text-success-700 {
    color: #047857 !important;
  }

  html:not(.dark) .text-success-900 {
    color: #064e3b !important;
  }

  /* Warning text */
  html:not(.dark) .text-warning-600 {
    color: #dc2626 !important;
  }

  html:not(.dark) .text-warning-700 {
    color: #b91c1c !important;
  }

  html:not(.dark) .text-warning-900 {
    color: #7f1d1d !important;
  }

  /* Featured text */
  html:not(.dark) .text-featured-800 {
    color: #92400e !important;
  }

  /* ===== BORDER COLORS ===== */
  html:not(.dark) .border-gray-200 {
    border-color: #e5e7eb !important;
  }

  html:not(.dark) .border-gray-300 {
    border-color: #d1d5db !important;
  }

  html:not(.dark) .border-primary-800 {
    border-color: #1e40af !important;
  }

  html:not(.dark) .border-featured-500 {
    border-color: #f59e0b !important;
  }

  html:not(.dark) .border-success-200 {
    border-color: #a7f3d0 !important;
  }

  html:not(.dark) .border-success-300 {
    border-color: #6ee7b7 !important;
  }

  html:not(.dark) .border-warning-200 {
    border-color: #fecaca !important;
  }

  html:not(.dark) .border-warning-300 {
    border-color: #fca5a5 !important;
  }

  /* ===== PLACEHOLDER COLORS ===== */
  html:not(.dark) .placeholder\:text-gray-500::placeholder {
    color: #6b7280 !important;
  }

  /* ===== HOVER STATES ===== */
  /* Background hovers */
  html:not(.dark) .hover\:bg-gray-50:hover {
    background-color: #f9fafb !important;
  }

  html:not(.dark) .hover\:bg-gray-100:hover {
    background-color: #f3f4f6 !important;
  }

  html:not(.dark) .hover\:bg-gray-300:hover {
    background-color: #d1d5db !important;
  }

  html:not(.dark) .hover\:bg-primary-50:hover {
    background-color: #eff6ff !important;
  }

  html:not(.dark) .hover\:bg-primary-900:hover {
    background-color: #1e3a8a !important;
  }

  html:not(.dark) .hover\:bg-success-100:hover {
    background-color: #d1fae5 !important;
  }

  html:not(.dark) .hover\:bg-success-700:hover {
    background-color: #047857 !important;
  }

  html:not(.dark) .hover\:bg-warning-100:hover {
    background-color: #fee2e2 !important;
  }

  html:not(.dark) .hover\:bg-warning-700:hover {
    background-color: #b91c1c !important;
  }

  /* Text hovers */
  html:not(.dark) .hover\:text-gray-900:hover {
    color: #111827 !important;
  }

  html:not(.dark) .hover\:text-success-900:hover {
    color: #064e3b !important;
  }

  html:not(.dark) .hover\:text-warning-900:hover {
    color: #7f1d1d !important;
  }

  /* Border hovers */
  html:not(.dark) .hover\:border-success-300:hover {
    border-color: #6ee7b7 !important;
  }

  html:not(.dark) .hover\:border-warning-300:hover {
    border-color: #fca5a5 !important;
  }

  /* ===== FOCUS STATES ===== */
  /* Background focus */
  html:not(.dark) .focus\:bg-primary-100:focus {
    background-color: #dbeafe !important;
  }

  /* Text focus */
  html:not(.dark) .focus\:text-primary-900:focus {
    color: #1e3a8a !important;
  }

  /* Ring colors */
  html:not(.dark) .focus\:ring-primary-500:focus,
  html:not(.dark) .focus-visible\:ring-primary-500:focus-visible,
  html:not(.dark) .focus\:ring-2:focus,
  html:not(.dark) .focus-visible\:ring-2:focus-visible {
    --tw-ring-color: #3b82f6 !important;
  }

  html:not(.dark) .focus\:ring-success-500:focus {
    --tw-ring-color: #10b981 !important;
  }

  html:not(.dark) .focus\:ring-warning-500:focus {
    --tw-ring-color: #ef4444 !important;
  }

  /* Ring offset */
  html:not(.dark) .ring-offset-white,
  html:not(.dark) .focus\:ring-offset-2:focus,
  html:not(.dark) .focus-visible\:ring-offset-2:focus-visible,
  html:not(.dark) .focus-visible\:ring-offset-white:focus-visible {
    --tw-ring-offset-color: #ffffff !important;
  }

  /* Outline */
  html:not(.dark) .focus\:outline-none:focus,
  html:not(.dark) .focus-visible\:outline-none:focus-visible {
    outline: none !important;
  }

  /* ===== DATA STATES ===== */
  /* Switch/Checkbox checked states */
  html:not(.dark) [data-state="checked"].bg-primary-800,
  html:not(.dark) .data-\[state\=checked\]\:bg-primary-800[data-state="checked"] {
    background-color: #1e40af !important;
  }

  html:not(.dark) [data-state="checked"].border-primary-800,
  html:not(.dark) .data-\[state\=checked\]\:border-primary-800[data-state="checked"] {
    border-color: #1e40af !important;
  }

  html:not(.dark) [data-state="unchecked"].bg-gray-300,
  html:not(.dark) .data-\[state\=unchecked\]\:bg-gray-300[data-state="unchecked"] {
    background-color: #d1d5db !important;
  }

  /* Tab active states */
  html:not(.dark) [data-state="active"].bg-white,
  html:not(.dark) .data-\[state\=active\]\:bg-white[data-state="active"] {
    background-color: #ffffff !important;
  }

  html:not(.dark) [data-state="active"].text-primary-900,
  html:not(.dark) .data-\[state\=active\]\:text-primary-900[data-state="active"] {
    color: #1e3a8a !important;
  }

  /* Table selected state */
  html:not(.dark) [data-state="selected"].bg-gray-100,
  html:not(.dark) .data-\[state\=selected\]\:bg-gray-100[data-state="selected"] {
    background-color: #f3f4f6 !important;
  }

  /* ===== DISABLED STATES ===== */
  html:not(.dark) .disabled\:cursor-not-allowed:disabled {
    cursor: not-allowed !important;
  }

  html:not(.dark) .disabled\:opacity-50:disabled {
    opacity: 0.5 !important;
  }

  html:not(.dark) .disabled\:pointer-events-none:disabled {
    pointer-events: none !important;
  }

  /* ===============================================
     DARK MODE UTILITIES - Complete Set
     =============================================== */

  /* ===== DARK BACKGROUND COLORS ===== */
  html.dark .dark\:bg-gray-600 {
    background-color: #4b5563 !important;
  }

  html.dark .dark\:bg-gray-700 {
    background-color: #374151 !important;
  }

  html.dark .dark\:bg-gray-800 {
    background-color: #1f2937 !important;
  }

  html.dark .dark\:bg-gray-900 {
    background-color: #111827 !important;
  }

  html.dark .dark\:bg-primary-600 {
    background-color: #2563eb !important;
  }

  html.dark .dark\:bg-primary-800 {
    background-color: #1e40af !important;
  }

  html.dark .dark\:bg-primary-900 {
    background-color: #1e3a8a !important;
  }

  html.dark .dark\:bg-primary-950 {
    background-color: #172554 !important;
  }

  html.dark .dark\:bg-success-900 {
    background-color: #064e3b !important;
  }

  html.dark .dark\:bg-success-950 {
    background-color: #022c22 !important;
  }

  html.dark .dark\:bg-warning-900 {
    background-color: #7f1d1d !important;
  }

  html.dark .dark\:bg-warning-950 {
    background-color: #450a0a !important;
  }

  html.dark .dark\:bg-featured-900 {
    background-color: #78350f !important;
  }

  /* ===== DARK TEXT COLORS ===== */
  html.dark .dark\:text-gray-100 {
    color: #f3f4f6 !important;
  }

  html.dark .dark\:text-gray-300 {
    color: #d1d5db !important;
  }

  html.dark .dark\:text-gray-400 {
    color: #9ca3af !important;
  }

  html.dark .dark\:text-gray-600 {
    color: #4b5563 !important;
  }

  html.dark .dark\:text-primary-100 {
    color: #dbeafe !important;
  }

  html.dark .dark\:text-primary-400 {
    color: #60a5fa !important;
  }

  html.dark .dark\:text-success-100 {
    color: #d1fae5 !important;
  }

  html.dark .dark\:text-success-300 {
    color: #6ee7b7 !important;
  }

  html.dark .dark\:text-success-400 {
    color: #34d399 !important;
  }

  html.dark .dark\:text-warning-100 {
    color: #fee2e2 !important;
  }

  html.dark .dark\:text-warning-300 {
    color: #fca5a5 !important;
  }

  html.dark .dark\:text-warning-400 {
    color: #f87171 !important;
  }

  html.dark .dark\:text-featured-300 {
    color: #fcd34d !important;
  }

  /* ===== DARK BORDER COLORS ===== */
  html.dark .dark\:border-gray-600 {
    border-color: #4b5563 !important;
  }

  html.dark .dark\:border-gray-700 {
    border-color: #374151 !important;
  }

  html.dark .dark\:border-primary-600 {
    border-color: #2563eb !important;
  }

  html.dark .dark\:border-success-700 {
    border-color: #047857 !important;
  }

  html.dark .dark\:border-success-700 {
    border-color: #047857 !important;
  }

  html.dark .dark\:border-success-800 {
    border-color: #065f46 !important;
  }

  html.dark .dark\:border-warning-700 {
    border-color: #b91c1c !important;
  }

  html.dark .dark\:border-warning-800 {
    border-color: #991b1b !important;
  }

  /* ===== DARK PLACEHOLDER COLORS ===== */
  html.dark .dark\:placeholder\:text-gray-400::placeholder {
    color: #9ca3af !important;
  }

  /* ===== DARK HOVER STATES ===== */
  html.dark .dark\:hover\:bg-gray-600:hover {
    background-color: #4b5563 !important;
  }

  html.dark .dark\:hover\:bg-gray-700:hover {
    background-color: #374151 !important;
  }

  html.dark .dark\:hover\:bg-gray-800:hover {
    background-color: #1f2937 !important;
  }

  html.dark .dark\:hover\:bg-gray-800\/50:hover {
    background-color: rgba(31, 41, 55, 0.5) !important;
  }

  html.dark .dark\:hover\:bg-primary-950:hover {
    background-color: #172554 !important;
  }

  html.dark .dark\:hover\:bg-success-900:hover {
    background-color: #064e3b !important;
  }

  html.dark .dark\:hover\:bg-warning-900:hover {
    background-color: #7f1d1d !important;
  }

  html.dark .dark\:hover\:text-gray-100:hover {
    color: #f3f4f6 !important;
  }

  html.dark .dark\:hover\:border-success-700:hover {
    border-color: #047857 !important;
  }

  html.dark .dark\:hover\:border-warning-700:hover {
    border-color: #b91c1c !important;
  }

  /* ===== DARK FOCUS STATES ===== */
  html.dark .dark\:focus\:bg-primary-900:focus {
    background-color: #1e3a8a !important;
  }

  html.dark .dark\:focus\:text-primary-100:focus {
    color: #dbeafe !important;
  }

  html.dark .dark\:focus\:ring-primary-400:focus,
  html.dark .dark\:focus-visible\:ring-primary-400:focus-visible {
    --tw-ring-color: #60a5fa !important;
  }

  html.dark .dark\:ring-offset-gray-900,
  html.dark .dark\:focus\:ring-offset-gray-900:focus,
  html.dark .dark\:focus-visible\:ring-offset-gray-900:focus-visible {
    --tw-ring-offset-color: #111827 !important;
  }

  /* ===== DARK DATA STATES ===== */
  html.dark [data-state="checked"].dark\:bg-primary-600[data-state="checked"],
  html.dark .dark\:data-\[state\=checked\]\:bg-primary-600[data-state="checked"] {
    background-color: #2563eb !important;
  }

  html.dark [data-state="checked"].dark\:border-primary-600[data-state="checked"],
  html.dark .dark\:data-\[state\=checked\]\:border-primary-600[data-state="checked"] {
    border-color: #2563eb !important;
  }

  html.dark [data-state="unchecked"].dark\:bg-gray-600[data-state="unchecked"],
  html.dark .dark\:data-\[state\=unchecked\]\:bg-gray-600[data-state="unchecked"] {
    background-color: #4b5563 !important;
  }

  html.dark [data-state="active"].dark\:bg-gray-900[data-state="active"],
  html.dark .dark\:data-\[state\=active\]\:bg-gray-900[data-state="active"] {
    background-color: #111827 !important;
  }

  html.dark [data-state="active"].dark\:text-primary-100[data-state="active"],
  html.dark .dark\:data-\[state\=active\]\:text-primary-100[data-state="active"] {
    color: #dbeafe !important;
  }

  html.dark [data-state="selected"].dark\:bg-gray-800[data-state="selected"],
  html.dark .dark\:data-\[state\=selected\]\:bg-gray-800[data-state="selected"] {
    background-color: #1f2937 !important;
  }
}

/* ============================================
   BASE STYLES - LIGHT MODE DEFAULT
   ============================================ */

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-sans);
  font-weight: 400;
  line-height: 1.5;
  background-color: #f9fafb;
  color: #111827;
}

/* Force light mode as default */
html:not(.dark) body {
  background-color: #f9fafb;
  color: #111827;
}

/* Dark mode */
html.dark body {
  background-color: #111827;
  color: #f9fafb;
}

/* ============================================
   RTL SUPPORT
   ============================================ */

[dir="rtl"] {
  direction: rtl;
  text-align: right;
}

[dir="rtl"] body {
  font-family: var(--font-sans-ar);
}

[dir="ltr"] {
  direction: ltr;
  text-align: left;
}

[dir="ltr"] body {
  font-family: var(--font-sans);
}

/* ============================================
   TYPOGRAPHY
   ============================================ */

h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  line-height: 1.2;
  color: #111827;
}

html.dark h1,
html.dark h2,
html.dark h3,
html.dark h4,
html.dark h5,
html.dark h6 {
  color: #f9fafb;
}

h1 { font-size: 2.25rem; }
h2 { font-size: 1.875rem; }
h3 { font-size: 1.5rem; }
h4 { font-size: 1.25rem; }
h5 { font-size: 1.125rem; }
h6 { font-size: 1rem; }

p {
  margin-bottom: 1rem;
  color: #4b5563;
}

html.dark p {
  color: #9ca3af;
}

a {
  text-decoration: none;
  transition: color 0.15s ease-out;
}

strong, b {
  font-weight: 600;
}

/* ============================================
   FOCUS STATES
   ============================================ */

:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
  border-radius: 0.375rem;
}

/* ============================================
   SELECTION
   ============================================ */

::selection {
  background-color: #a7f3d0;
  color: #064e3b;
}

html.dark ::selection {
  background-color: #065f46;
  color: #d1fae5;
}

/* ============================================
   SCROLLBAR - Light Mode
   ============================================ */

::-webkit-scrollbar {
  width: 12px;
  height: 12px;
}

::-webkit-scrollbar-track {
  background: #f3f4f6;
}

::-webkit-scrollbar-thumb {
  background: #9ca3af;
  border-radius: 9999px;
  border: 2px solid #f3f4f6;
}

::-webkit-scrollbar-thumb:hover {
  background: #6b7280;
}

html.dark ::-webkit-scrollbar-track {
  background: #1f2937;
}

html.dark ::-webkit-scrollbar-thumb {
  background: #4b5563;
  border-color: #1f2937;
}

html.dark ::-webkit-scrollbar-thumb:hover {
  background: #6b7280;
}

/* ============================================
   PRICE TYPOGRAPHY
   ============================================ */

.price,
.price-display,
.tabular-nums,
[class*="price"] {
  font-feature-settings: "tnum";
  font-variant-numeric: tabular-nums;
}

/* ============================================
   UTILITY CLASSES
   ============================================ */

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

/* Container */
.container {
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: 1rem;
  padding-right: 1rem;
}

@media (min-width: 640px) {
  .container { max-width: 640px; }
}

@media (min-width: 768px) {
  .container {
    max-width: 768px;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

@media (min-width: 1024px) {
  .container {
    max-width: 1024px;
    padding-left: 2rem;
    padding-right: 2rem;
  }
}

@media (min-width: 1280px) {
  .container { max-width: 1280px; }
}

@media (min-width: 1536px) {
  .container { max-width: 1536px; }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ============================================
   PRINT STYLES
   ============================================ */

@media print {
  body {
    background: white;
    color: black;
  }

  .no-print {
    display: none !important;
  }
}

