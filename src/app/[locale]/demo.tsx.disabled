                    {locale === 'ar'
                      ? 'هذا هو محتوى الإجابة على السؤال الثاني'
                      : 'This is the answer content for question 2'}
                  </AccordionContent>
                </AccordionItem>
              </Accordion>

              <Separator />

              {/* ScrollArea */}
              <div className="space-y-2">
                <h3 className="text-sm font-semibold text-gray-700 dark:text-gray-300">
                  ScrollArea
                </h3>
                <ScrollArea className="h-[200px] w-full rounded-lg border p-4">
                  <div className="space-y-4">
                    {Array.from({ length: 20 }).map((_, i) => (
                      <p key={i} className="text-sm text-gray-600 dark:text-gray-400">
                        {locale === 'ar' ? `عنصر ${i + 1}` : `Item ${i + 1}`}
                      </p>
                    ))}
                  </div>
                </ScrollArea>
              </div>
            </CardContent>
          </Card>

          {/* Feedback Components */}
          <div className="space-y-4">
            <h2 className="text-2xl font-bold">{locale === 'ar' ? 'التنبيهات' : 'Alerts'}</h2>
            <Alert variant="success">
              <AlertCircle className="h-4 w-4" />
              <AlertTitle>{locale === 'ar' ? 'نجح!' : 'Success!'}</AlertTitle>
              <AlertDescription>
                {locale === 'ar'
                  ? 'تم حفظ التغييرات بنجاح'
                  : 'Your changes have been saved successfully'}
              </AlertDescription>
            </Alert>

            <Alert variant="warning">
              <AlertCircle className="h-4 w-4" />
              <AlertTitle>{locale === 'ar' ? 'تحذير' : 'Warning'}</AlertTitle>
              <AlertDescription>
                {locale === 'ar' ? 'يرجى مراجعة المعلومات' : 'Please review the information'}
              </AlertDescription>
            </Alert>

            <Alert>
              <Info className="h-4 w-4" />
              <AlertTitle>{locale === 'ar' ? 'معلومة' : 'Info'}</AlertTitle>
              <AlertDescription>
                {locale === 'ar' ? 'هذه رسالة معلوماتية' : 'This is an informational message'}
              </AlertDescription>
            </Alert>
          </div>

          {/* Display Components */}
          <Card>
            <CardHeader>
              <CardTitle>{locale === 'ar' ? 'مكونات العرض' : 'Display Components'}</CardTitle>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="flex items-center gap-4">
                <Avatar>
                  <AvatarImage src="https://github.com/shadcn.png" />
                  <AvatarFallback>AB</AvatarFallback>
                </Avatar>
                <div>
                  <p className="font-medium">{locale === 'ar' ? 'اسم المستخدم' : 'Username'}</p>
                  <p className="text-sm text-gray-500">user@example.com</p>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* Empty State */}
          <EmptyState
            icon={<Package className="h-12 w-12" />}
            title={locale === 'ar' ? 'لا توجد منتجات' : 'No products found'}
            description={locale === 'ar' ? 'جرب تعديل الفلاتر أو البحث' : 'Try adjusting your filters or search terms'}
            action={{
              label: locale === 'ar' ? 'مسح الفلاتر' : 'Clear Filters',
              onClick: () => console.log('Clear filters'),
            }}
          />

          {/* Component Count Summary */}
          <Card className="bg-gradient-to-br from-primary-50 to-primary-100 dark:from-primary-950 dark:to-primary-900 border-primary-200 dark:border-primary-800">
            <CardContent className="pt-6">
              <div className="text-center space-y-4">
                <p className="text-7xl font-extrabold text-primary-800 dark:text-primary-400">
                  33
                </p>
                <p className="text-2xl font-bold text-primary-900 dark:text-primary-300">
                  {locale === 'ar' ? 'مكون جاهز للاستخدام' : 'Production-Ready Components'}
                </p>
                <div className="flex flex-wrap justify-center gap-2">
                  <Badge variant="success-light">
                    {locale === 'ar' ? 'الثيم الفاتح/الداكن ✓' : 'Light/Dark Theme ✓'}
                  </Badge>
                  <Badge variant="success-light">
                    {locale === 'ar' ? 'RTL/LTR ✓' : 'RTL/LTR ✓'}
                  </Badge>
                  <Badge variant="success-light">
                    {locale === 'ar' ? 'عربي/إنجليزي ✓' : 'Arabic/English ✓'}
                  </Badge>
                  <Badge variant="success-light">
                    {locale === 'ar' ? 'إمكانية الوصول ✓' : 'Accessible ✓'}
                  </Badge>
                </div>
                <p className="text-sm text-primary-700 dark:text-primary-400 max-w-2xl mx-auto">
                  {locale === 'ar'
                    ? 'جميع المكونات مصممة لمنصة مقارنة الأسعار مع دعم كامل للثيمات واللغات والاتجاهات'
                    : 'All components designed for price comparison platform with full theme, language, and direction support'}
                </p>
              </div>
            </CardContent>
          </Card>
        </div>
      </main>
    </>
  );
}
